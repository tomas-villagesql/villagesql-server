INSTALL EXTENSION vsql_knn_index_test;
#
# Control: index created on the empty table.
#
CREATE TABLE t (id INT PRIMARY KEY, v KVECTOR);
CREATE INDEX idx_v ON t (v kvec_profile_l2_ref)
USING EXTENDED(vsql_knn_index_test.kvec_l2_ref);
# Distances from [0,0,0,0] are 1, 2, 3 and 4; rows 5 and 6 are NULL.
INSERT INTO t VALUES
(1, '[1,0,0,0]'),
(2, '[2,0,0,0]'),
(3, '[3,0,0,0]'),
(4, '[4,0,0,0]'),
(5, NULL),
(6, NULL);
# Expected: 4 entries, one per non-NULL row
entries
4
EXPLAIN FORMAT=tree
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
EXPLAIN
-> Limit: 10 row(s)  (cost=COST rows=ROWS)
    -> Index KNN scan on t using idx_v (v <-> '[0,0,0,0]'), limit 10  (cost=COST rows=ROWS)

# Expected: 1, 2, 3, 4
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
id
1
2
3
4
# Rollback of a delete unmarks the entry.
BEGIN;
DELETE FROM t WHERE id = 1;
# Expected: 2, 3, 4
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
id
2
3
4
ROLLBACK;
# Expected: 1, 2, 3, 4
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
id
1
2
3
4
# Rollback of a vector update unmarks the entry.
BEGIN;
UPDATE t SET v = '[10,0,0,0]' WHERE id = 2;
# Expected: 1, 3, 4, 2
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
id
1
3
4
2
ROLLBACK;
# Expected: 1, 2, 3, 4
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
id
1
2
3
4
# Expected: 4 entries
entries
4
# Purge of a deleted row removes its entry.
DELETE FROM t WHERE id = 3;
# Expected: 3 entries
entries
3
# Expected: 1, 2, 4
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
id
1
2
4
# Purge after a vector update removes the old entry.
UPDATE t SET v = '[5,0,0,0]' WHERE id = 4;
# Expected: 3 entries
entries
3
# Expected: 1, 2, 4
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
id
1
2
4
# A NULL row has no entry: deleting one removes nothing, and giving one
# a vector adds an entry.
DELETE FROM t WHERE id = 5;
UPDATE t SET v = '[0.5,0,0,0]' WHERE id = 6;
# Expected: 4 entries
entries
4
# Expected: 6, 1, 2, 4
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
id
6
1
2
4
DROP TABLE t;
# Expected: 0 entries. Gets 4, in the control too: DROP TABLE does not
# call the custom index drop callback (knn_review KNN-20).
entries
4
#
# Index created on the populated table.
#
CREATE TABLE t (id INT PRIMARY KEY, v KVECTOR);
# Distances from [0,0,0,0] are 1, 2, 3 and 4; rows 5 and 6 are NULL.
INSERT INTO t VALUES
(1, '[1,0,0,0]'),
(2, '[2,0,0,0]'),
(3, '[3,0,0,0]'),
(4, '[4,0,0,0]'),
(5, NULL),
(6, NULL);
CREATE INDEX idx_v ON t (v kvec_profile_l2_ref)
USING EXTENDED(vsql_knn_index_test.kvec_l2_ref);
# Expected: 4 entries, one per non-NULL row
entries
4
EXPLAIN FORMAT=tree
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
EXPLAIN
-> Limit: 10 row(s)  (cost=COST rows=ROWS)
    -> Index KNN scan on t using idx_v (v <-> '[0,0,0,0]'), limit 10  (cost=COST rows=ROWS)

# Expected: 1, 2, 3, 4
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
id
1
2
3
4
# Rollback of a delete unmarks the entry.
BEGIN;
DELETE FROM t WHERE id = 1;
# Expected: 2, 3, 4
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
id
2
3
4
ROLLBACK;
# Expected: 1, 2, 3, 4
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
id
1
2
3
4
# Rollback of a vector update unmarks the entry.
BEGIN;
UPDATE t SET v = '[10,0,0,0]' WHERE id = 2;
# Expected: 1, 3, 4, 2
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
id
1
3
4
2
ROLLBACK;
# Expected: 1, 2, 3, 4
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
id
1
2
3
4
# Expected: 4 entries
entries
4
# Purge of a deleted row removes its entry.
DELETE FROM t WHERE id = 3;
# Expected: 3 entries
entries
3
# Expected: 1, 2, 4
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
id
1
2
4
# Purge after a vector update removes the old entry.
UPDATE t SET v = '[5,0,0,0]' WHERE id = 4;
# Expected: 3 entries
entries
3
# Expected: 1, 2, 4
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
id
1
2
4
# A NULL row has no entry: deleting one removes nothing, and giving one
# a vector adds an entry.
DELETE FROM t WHERE id = 5;
UPDATE t SET v = '[0.5,0,0,0]' WHERE id = 6;
# Expected: 4 entries
entries
4
# Expected: 6, 1, 2, 4
SELECT id FROM t
ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
id
6
1
2
4
DROP TABLE t;
# Expected: 0 entries. Gets 4, in the control too: DROP TABLE does not
# call the custom index drop callback (knn_review KNN-20).
entries
4
#
# NULL rows with an index type without REF_LOOKUP.
#
CREATE TABLE t2 (id INT PRIMARY KEY, v KVECTOR);
INSERT INTO t2 VALUES (1, '[1,0,0,0]'), (2, NULL), (3, '[3,0,0,0]');
CREATE INDEX idx_v ON t2 (v)
USING EXTENDED(vsql_knn_index_test.kvec_l2);
# Expected: 2 entries
entries
2
# Expected: 1, 3
SELECT id FROM t2
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 10;
id
1
3
DROP TABLE t2;
UNINSTALL EXTENSION vsql_knn_index_test;
