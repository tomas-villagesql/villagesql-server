# CREATE INDEX on a populated table, for an index type that declares REF_LOOKUP
# (as vsql-vector's HNSW does). The build keeps the entry reference that the
# extension insert returns in the mapping B-tree. Rollback and purge find the
# extension entry by that reference, so they only work on built entries if the
# build kept it.
#
# The same steps run twice: first with the index created on the empty table and
# the rows inserted after it (the control), then with the index created on the
# populated table. Both runs must give the same results.
#
# Rows with a NULL vector get no entry, also for an index type without
# REF_LOOKUP.
#
# wait_innodb_all_purged.inc can return before purge has removed the index
# entries, so purge steps wait for the entry count itself. A wait that times
# out prints "Timeout in wait_condition.inc" and the count shows what is left.

INSTALL EXTENSION vsql_knn_index_test;
--let $wait_timeout = 10

--let $populated = 0
while ($populated < 2)
{
  if (!$populated)
  {
    --echo #
    --echo # Control: index created on the empty table.
    --echo #
  }
  if ($populated)
  {
    --echo #
    --echo # Index created on the populated table.
    --echo #
  }
  --let $base = `SELECT vsql_knn_index_test.kvec_entry_count()`
  CREATE TABLE t (id INT PRIMARY KEY, v KVECTOR);
  if (!$populated)
  {
    CREATE INDEX idx_v ON t (v kvec_profile_l2_ref)
      USING EXTENDED(vsql_knn_index_test.kvec_l2_ref);
  }
  --echo # Distances from [0,0,0,0] are 1, 2, 3 and 4; rows 5 and 6 are NULL.
  INSERT INTO t VALUES
    (1, '[1,0,0,0]'),
    (2, '[2,0,0,0]'),
    (3, '[3,0,0,0]'),
    (4, '[4,0,0,0]'),
    (5, NULL),
    (6, NULL);
  if ($populated)
  {
    CREATE INDEX idx_v ON t (v kvec_profile_l2_ref)
      USING EXTENDED(vsql_knn_index_test.kvec_l2_ref);
  }
  --echo # Expected: 4 entries, one per non-NULL row
  --disable_query_log
  --eval SELECT vsql_knn_index_test.kvec_entry_count() - $base AS entries
  --enable_query_log

  --replace_regex /cost=[0-9.e+-]+/cost=COST/ /rows=[0-9.e+-]+/rows=ROWS/
  EXPLAIN FORMAT=tree
  SELECT id FROM t
  ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
  --echo # Expected: 1, 2, 3, 4
  SELECT id FROM t
  ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;

  --echo # Rollback of a delete unmarks the entry.
  BEGIN;
  DELETE FROM t WHERE id = 1;
  --echo # Expected: 2, 3, 4
  SELECT id FROM t
  ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
  ROLLBACK;
  --echo # Expected: 1, 2, 3, 4
  SELECT id FROM t
  ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;

  --echo # Rollback of a vector update unmarks the entry.
  BEGIN;
  UPDATE t SET v = '[10,0,0,0]' WHERE id = 2;
  --echo # Expected: 1, 3, 4, 2
  SELECT id FROM t
  ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
  ROLLBACK;
  --echo # Expected: 1, 2, 3, 4
  SELECT id FROM t
  ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;
  --echo # Expected: 4 entries
  --disable_query_log
  --eval SELECT vsql_knn_index_test.kvec_entry_count() - $base AS entries
  --enable_query_log

  --echo # Purge of a deleted row removes its entry.
  DELETE FROM t WHERE id = 3;
  --let $wait_condition = SELECT vsql_knn_index_test.kvec_entry_count() - $base = 3
  --source include/wait_condition.inc
  --echo # Expected: 3 entries
  --disable_query_log
  --eval SELECT vsql_knn_index_test.kvec_entry_count() - $base AS entries
  --enable_query_log
  --echo # Expected: 1, 2, 4
  SELECT id FROM t
  ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;

  --echo # Purge after a vector update removes the old entry.
  UPDATE t SET v = '[5,0,0,0]' WHERE id = 4;
  --let $wait_condition = SELECT vsql_knn_index_test.kvec_entry_count() - $base = 3
  --source include/wait_condition.inc
  --echo # Expected: 3 entries
  --disable_query_log
  --eval SELECT vsql_knn_index_test.kvec_entry_count() - $base AS entries
  --enable_query_log
  --echo # Expected: 1, 2, 4
  SELECT id FROM t
  ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;

  --echo # A NULL row has no entry: deleting one removes nothing, and giving one
  --echo # a vector adds an entry.
  DELETE FROM t WHERE id = 5;
  UPDATE t SET v = '[0.5,0,0,0]' WHERE id = 6;
  --let $wait_condition = SELECT vsql_knn_index_test.kvec_entry_count() - $base = 4
  --source include/wait_condition.inc
  --echo # Expected: 4 entries
  --disable_query_log
  --eval SELECT vsql_knn_index_test.kvec_entry_count() - $base AS entries
  --enable_query_log
  --echo # Expected: 6, 1, 2, 4
  SELECT id FROM t
  ORDER BY vsql_knn_index_test.kvec_l2_ref_distance(v, '[0,0,0,0]') LIMIT 10;

  DROP TABLE t;
  --echo # Expected: 0 entries. Gets 4, in the control too: DROP TABLE does not
  --echo # call the custom index drop callback (knn_review KNN-20).
  --disable_query_log
  --eval SELECT vsql_knn_index_test.kvec_entry_count() - $base AS entries
  --enable_query_log

  --inc $populated
}

--echo #
--echo # NULL rows with an index type without REF_LOOKUP.
--echo #
CREATE TABLE t2 (id INT PRIMARY KEY, v KVECTOR);
INSERT INTO t2 VALUES (1, '[1,0,0,0]'), (2, NULL), (3, '[3,0,0,0]');
--let $base = `SELECT vsql_knn_index_test.kvec_entry_count()`
CREATE INDEX idx_v ON t2 (v)
  USING EXTENDED(vsql_knn_index_test.kvec_l2);
--echo # Expected: 2 entries
--disable_query_log
--eval SELECT vsql_knn_index_test.kvec_entry_count() - $base AS entries
--enable_query_log
--echo # Expected: 1, 3
SELECT id FROM t2
ORDER BY vsql_knn_index_test.kvec_l2_distance(v, '[0,0,0,0]') LIMIT 10;
DROP TABLE t2;

UNINSTALL EXTENSION vsql_knn_index_test;
